NODE_ENV=development
APP_BASE_URL=https://your-wangp-host.your-tailnet.ts.net
WANGP_MCP_URL=http://127.0.0.1:7866/mcp
WANGP_OUTPUT_ROOT=C:\WanGP\outputs
WANGP_LORA_ROOT=C:\WanGP\loras
WANGP_PROFILES_ROOT=C:\WanGP\profiles
WANGP_LORA_METADATA_ROOT=C:\WanGP\loras_metadata
WANGP_LORA_CLASSIFIER_OVERRIDES=C:\Path\To\EasyMediaGen\data\lora-classifier-overrides.json
WANGP_DISCOVERY_CACHE_MINUTES=30
WANGP_CLIENT_MODE=fake

ENABLED_IMAGE_CREATE_MODELS=qwen-image,flux-klein-9b,krea-2
ENABLED_IMAGE_EDIT_MODELS=qwen-image-edit,flux-klein-9b,krea-2-edit
DEFAULT_IMAGE_CREATE_MODEL=qwen-image
DEFAULT_IMAGE_EDIT_MODEL=qwen-image-edit
DEFAULT_VIDEO_MODEL=minimax_h3_fl2va_pruned_pdd

# Prompt enhancement (LM Studio, or any OpenAI-compatible local server).
# Leave LM_STUDIO_BASE_URL empty to hide the "Enhance prompt" button.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Empty asks LM Studio which model is currently loaded.
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=local
LM_STUDIO_TEMPERATURE=0.7
LM_STUDIO_MAX_TOKENS=8000
LM_STUDIO_TIMEOUT_MS=240000
# Eject the language model from the GPU before every generation.
LM_STUDIO_UNLOAD_BEFORE_GENERATION=true
LM_STUDIO_CLI_PATH=lms
LM_STUDIO_CLI_TIMEOUT_MS=60000

MAX_ACTIVE_GENERATION_JOBS=1
MAX_QUEUED_JOBS=20
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_OUTPUT_MB=1000

ENABLE_LOCAL_PASSCODE=false
LOCAL_PASSCODE_HASH=
LOG_LEVEL=info